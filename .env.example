# Django Core Settings
# DEBUG, SECRET_KEY et ALLOWED_HOSTS sont OBLIGATOIRES : sans .env, l'application
# refuse de démarrer (par sécurité, plutôt que de retomber sur DEBUG=True et une
# clé secrète publique). Générez une vraie clé avec :
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DEBUG=False
SECRET_KEY=change-this-to-a-super-secret-random-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,dekouway.sn,www.dekouway.sn
# Requis en production (DEBUG=False) : origines autorisées à passer la protection CSRF.
CSRF_TRUSTED_ORIGINS=https://dekouway.sn,https://www.dekouway.sn
# Forcer la redirection HTTPS (désactivez uniquement si un load balancer/reverse-proxy le fait déjà)
SECURE_SSL_REDIRECT=True

# PostgreSQL Database Configuration
POSTGRES_DB=dekouway_db
POSTGRES_USER=dekouway_user
POSTGRES_PASSWORD=securepassword123
POSTGRES_HOST=db
POSTGRES_PORT=5432
# IMPORTANT : Django lit exclusivement DATABASE_URL (pas les variables POSTGRES_* ci-dessus,
# qui ne servent qu'à initialiser le conteneur PostgreSQL de docker-compose). Sans cette
# ligne, l'application bascule silencieusement sur un fichier SQLite éphémère dans le
# conteneur "web" et TOUTES les données sont perdues à chaque redéploiement.
# L'hôte doit être "db" (nom du service docker-compose), pas "localhost".
DATABASE_URL=postgres://dekouway_user:securepassword123@db:5432/dekouway_db

# Redis Cache & Broker Configuration
REDIS_URL=redis://redis:6379/1
# Gunicorn tourne avec plusieurs workers : sans cache partagé, chaque worker aurait
# ses propres compteurs de rate-limiting (LocMemCache est par processus). Redis est
# déjà démarré par docker-compose, donc on l'utilise par défaut.
CACHE_BACKEND=django_redis.cache.RedisCache
CACHE_LOCATION=redis://redis:6379/2

# Groq LLM API Configuration
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT=10.0

# Sentry Monitoring DSN (Optionnel)
SENTRY_DSN=

# Jeton exigé en en-tête X-Metrics-Token pour accéder à /metrics/ (Prometheus).
# Laissé vide, l'endpoint refuse tout accès par défaut.
METRICS_TOKEN=change-this-to-a-random-token-shared-with-your-prometheus-scraper

# Email Settings
# En dev, laissez EMAIL_BACKEND vide (ou en console) : les emails s'affichent dans les logs.
# En production, décommentez la ligne SMTP et renseignez les identifiants ci-dessous.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@dekouway.sn
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@dekouway.sn
